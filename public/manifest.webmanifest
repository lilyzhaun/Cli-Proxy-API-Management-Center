{
  "id": "/",
  "name": "CLI Proxy API Management Center",
  "short_name": "CPAMC",
  "description": "Web management interface for CLI Proxy API",
  "lang": "zh-CN",
  "start_url": "./",
  "scope": "./",
  "display_override": ["window-controls-overlay", "standalone"],
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0b1220",
  "theme_color": "#0b1220",
  "categories": ["productivity", "developer"],
  "prefer_related_applications": false,
  "icons": [
    {
      "src": "./pwa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    },
    {
      "src": "./logo.jpg",
      "sizes": "512x512",
      "type": "image/jpeg",
      "purpose": "any"
    }
  ]
}
